# 构建产物，不进版本库。
# pack/ 由 tools/vendor.ps1 按 vendor/lock.json 复现 ——
# 注意 vendor/lock.json 本身要提交，它是「可复现」的凭证。
build/
pack/

# 打包产物
dist.zip
dist.tar.gz

# 编辑器杂项
*.swp
.DS_Store

# nvim 写日志失败时会落在当前目录
nvim.log
.nvimlog

# Python 字节码缓存
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# bin/ 里的工具二进制由 tools/fetch-tools.ps1 在 CI 构建时按平台下载。
# 6 个平台的二进制上百 MB，提交进 git 会让仓库**永久**膨胀 ——
# git 历史不会因为后来的删除而变小，所以一开始就不该进去。
#
# 例外：bin/im-select.exe 留在版本库。它上游的产物名不含平台信息（无法可靠匹配），
# 只有约 200 KB，且只在 Windows 需要 —— 为它写一套猜测式的下载规则不划算。
# ---------------------------------------------------------------------------
bin/rg
bin/rg.exe
bin/fzf
bin/fzf.exe
bin/fd
bin/fd.exe
bin/stylua
bin/stylua.exe
bin/shfmt
bin/shfmt.exe
bin/shellcheck
bin/shellcheck.exe
# manifest 记录「本平台包里实际有哪些工具」，由 CI 每次构建现生成。
# 提交在版本库里的那份必然过时（工具二进制已移出版本库），只会误导。
bin/manifest.json

# 构建产物
runtime/
dist/

# 发行版运行期状态（nvim.cmd/nvim.sh 把 XDG 指到这里）
.local/
/packednvim
/mermaid-demo.md
